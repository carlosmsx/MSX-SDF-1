	TITLE   DSKDRV - MSXDOS disk driver for MSX-IoT hardware -
	.Z80
	
;How to compile:
;  1) RunCPM
;  1.1) M80 =dskdrv.mac
;  1.2) l80 /p:4000,/d:f237,doshead,bios,msxdos,smldisp,init,dskbasic,msxdata,dskdrv,basdata,msxdos/n/x/y/e
;  2) hex2bin -e rom -l 4000 a\0\msxdos.hex

;28815 - 23438 = 5377
;28815 - 26510 = 2305

; External variables & routines
CHPUT   	EQU     000A2H
CALBAS		EQU		00159H
ERRHAND 	EQU     0406FH
FRMEVL  	EQU     04C64H
FRMQNT		EQU		0542FH			;evalua una expresion entera, la deja en DE
CHRGTR  	EQU     04666H
VALTYP  	EQU     0F663H
USR     	EQU     0F7F8H
PROCNM		EQU		0FD89H
GETBYT		EQU		0521CH
;ENASLT  	EQU     00024H          ;enable slot
;RSLREG  	EQU     00138H          ;read primary slot select register
;RSLGREG 	EQU		00138H
;BOTTOM		EQU		0FC48H
;HIMEM		EQU		0FC4AH
;SLTWRK		EQU		0FD09H
;EXPTBL  	EQU     0FCC1H          ;slot is expanded or not
;CALSLT		EQU		0001CH

; symbols which can be used from the kernel

; GETSLT	get my slotid
; DIV16		divide

EXTRN		GETWRK          ;get base  of  work  area  in  [IX]  and
							;[HL]
; SETINT	install my interrupt handler
; PRVINT	call orginal interrupt handler
EXTRN		SETINT,PRVINT
; PROMPT	prompt for phantom drive
; RAWFLG	verify flag
; $SECBUF	temporary sectorbuffer
EXTRN		$SECBUF
; GETSLOT	slot del cartucho, para poner la pagina 2 (ver CALLP2)
; ENASLT	habilita un slot en una pagina
; RAMAD2	slot de la RAM de la pagina 2
EXTRN		GETSLOT,ENASLT,RAMAD2
; XFER		transfer to TPA
; DISINT	inform interrupts are being disabled
; ENAINT	inform interrupts are being enabled
;EXTRN		PROCNM			;CALL statement name

; symbols which must be defined by the driver

; INIHRD	initialize diskdriver hardware
; DRIVES	how many drives are connected
; INIENV	initialize diskdriver workarea
; DSKIO		diskdriver sector i/o
; DSKCHG	diskdriver diskchange status
; GETDPB	build Drive Parameter Block
; CHOICE	get format choice string
; DSKFMT	format disk
; MTOFF		stop diskmotor
; OEMSTA	diskdriver special call statements

; MYSIZE	size of diskdriver workarea
; SECLEN	size of biggest sector supported by the diskdriver
; DEFDPB	pointer to a default Drive Parameter Block



; errorcodes used by DSKIO, DSKCHG and GETDPB
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	other error

; errorcodes used by DSKFMT
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	bad parameter
; 14	insufficient memory
; 16	other error

	PUBLIC	MYSIZE
MYSIZE		equ	1		; Size of environment
	PUBLIC	SECLEN
SECLEN		equ	512		; Size of biggest sector

;----Protocolo con el firmware: comandos, respuestas y puertos----
	INCLUDE	PROTOCOL.INC

;----Pagina 2----
;Entradas de la tabla de saltos de PAGE2.MAC, que empieza en 8000h. El orden
;es el contrato entre los dos archivos. Se llaman con CALLP2.
P2_FORMAT	EQU		8000H
P2_NEWDSK	EQU		8003H
P2_SDFFILES	EQU		8006H
P2_SDFTEST	EQU		8009H

WriteByte:
	OUT		(PORT_DATA),A
	EX 		(SP),HL		;19 cycles
	EX		(SP),HL		;19 cycles
	RET

WriteCommand:
	OUT		(PORT_CMD),A
	EX		(SP),HL
	EX		(SP),HL
	RET

WriteBlock:
	OUTI
	EX		(SP),HL
	EX		(SP),HL
	JR		NZ,WriteBlock
	RET

ReadByte:
	IN		A,(PORT_DATA)
	EX		(SP),HL
	EX		(SP),HL
	RET

ReadBlock:
	IN		D,(C)
	LD		(HL),D
	XOR		D		; CHECKSUM XOR8 EN EL ACUMULADOR
	INC		HL
	EX		(SP),HL
	EX		(SP),HL
	DJNZ	ReadBlock
	RET

; INIHRD
;
; Input:	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	INIHRD
INIHRD:
	LD		A,CMD_INIHRD
	CALL	WriteCommand
	RET

; DRIVES
;
; Input: 	F	Zx set if to return physical drives
;			Zx reset if to return at least 2 drives, if only one
;			  physical drive it becomes a phantom drive
; Output:	L	number of drives
; Changed:	F,HL,IX,IY may be affected
;
; Remark:	DOS1 does not handle L=0 correctly

	PUBLIC	DRIVES
DRIVES:
	PUSH	AF
	LD		A,CMD_DRIVES
	CALL	WriteCommand
	POP		AF
	LD		L,2
	RET

; INIENV
;
; Input: 	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Remark:	examples installs own interrupt handler, but this is NOT required.
;		depends on the hardware if this is needed.

	PUBLIC	INIENV
INIENV:
	PUSH	AF
	LD		A,CMD_INIENV
	CALL	WriteCommand
	POP		AF
	
	RET		;do nothing
	
	CALL	GETWRK
	LD		(HL),1
	LD		HL,INTHAND
	JP		SETINT

INTHAND:	
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	IX
	PUSH	IY
	CALL	GETWRK
	INC		(HL)
	POP		IY
	POP		IX
	POP		HL
	POP		DE
	POP		BC
	POP		AF
	JP		PRVINT

;
; DSKIO
;
; Input: 	A	Drivenumber
;		F	Cx reset for read
;			Cx set for write
; 		B	number of sectors
; 		C	Media descriptor
;		DE	logical sectornumber
; 		HL	transferaddress
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if error, remaining sectors
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	DSKIO
DSKIO:
	PUSH	AF
	JP      NC,READ         ;if no carry, we should read
WRITE:
	LD		A,CMD_WRITE		;write
	CALL	WriteCommand
	POP		AF				;drive number
	CALL	WriteByte
	LD		A,B				;n-sectors
	CALL	WriteByte
	LD		A,C				;media
	CALL	WriteByte
	LD		A,H
	CALL	WriteByte
	LD		A,L
	CALL	WriteByte
	LD		A,D				;sec Hi
	CALL	WriteByte
	LD		A,E				;sec Lo
	CALL	WriteByte
	CALL	ReadByte		;estado: 0 ok, si no el error de DSKIO
	OR		A
	JR		NZ,DSKIOERROR
	LD		D,B				;store n-sectors ;/\
WRSEC:
	PUSH	BC				;only B matters
	LD		BC,0			;B=0 to count until 256, C=0 for OUTI
	CALL	WriteBlock		;256 bytes
	CALL	WriteBlock		;256 bytes
	POP		BC
	DJNZ	WRSEC			;relative jump
	LD		B,D				;restore n-sectors ;/\
	SCF
	CCF						;no errors
	RET
	
DSKIOERROR:
	SCF						;A=error code, B=remaining sectors (todos)
	RET

READ:
	LD		A,CMD_READ		;read
	CALL	WriteCommand
	POP		AF				;drive number
	CALL	WriteByte		
	LD		A,B				;n-sectors
	CALL	WriteByte		
	LD		A,C				;media
	CALL	WriteByte
	LD		A,H
	CALL	WriteByte
	LD		A,L
	CALL	WriteByte
	LD		A,D				;sec H
	CALL	WriteByte
	LD		A,E				;sec L
	CALL	WriteByte
	CALL	ReadByte		;estado: 0 ok, si no el error de DSKIO
	OR		A
	JR		NZ,DSKIOERROR
RDSEC:
	PUSH	BC				;only B matters
	LD		BC,0			;B=0 to count until 256 bytes, C=0 for INI
	XOR		A				;calculated checksum
	CALL	ReadBlock		;256 bytes
	CALL	ReadBlock		;256 bytes
	;INC		C				;C=1
	
	PUSH	AF
	LD		A,CMD_DEBUG
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte
	
	;IN		D,(C)			;remote checksum
	POP		BC
	;CP		D				;compare checksums
	;JR		Z,RDS_CONTINUE
	;SCF
	;LD		A,4				;checksum error
	;RET
RDS_CONTINUE:
	DJNZ	RDSEC			;relative jump
	;ld		a,12
	SCF
	CCF						;no errors
	RET


; DSKCHG
;
; Input: 	A	Drivenumber
; 		B	0
; 		C	Media descriptor
; 		HL	pointer to DPB
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if no error, disk change status
;			01 disk unchanged
;			00 unknown
;			FF disk changed
; Changed:	AF,BC,DE,HL,IX,IY may be affected
; Remark:	DOS1 kernel expects the DPB updated when disk change status is unknown or changed
;		DOS2 kernel does not care if the DPB is updated or not

	PUBLIC	DSKCHG
DSKCHG:
	PUSH	AF
	LD		A,CMD_DSKCHG
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive number
	CALL	ReadByte		;01 sin cambio, FF cambiado por CALL SDFMOUNT
	LD		B,A
	INC		A
	JR		NZ,.NOCHANGE
	PUSH	BC
	CALL	GETDPB			;con FF, DOS1 espera el DPB actualizado en [HL]
	POP		BC
.NOCHANGE:
	OR		A				;no errors
	RET

; GETDPB
;
; Input: 	A	Drivenumber
; 		B	first byte of FAT
; 		C	Media descriptor
; 		HL	pointer to DPB
; Output:	[HL+1]
;		..
;		[HL+18]	updated
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	GETDPB
;
; El kernel de DOS1 lee la FAT despues de un DSKCHG con cambio y llama aca con
; su primer byte en B: F8 es un 360 KB, cualquier otra cosa se toma como
; 720 KB. Desde nuestro DSKCHG llega B=FF, antes de que el kernel lea la FAT:
; ese DPB de 720 KB dura hasta que el kernel vuelve a llamar con el byte real.

GETDPB:
	PUSH	AF
	LD		A,CMD_GETDPB
	CALL	WriteCommand
	POP		AF
	EX		DE,HL		;porque no existe LD DE,HL
	INC		DE
	LD		HL,DpbTable		;720 KB
	LD		A,B				;primer byte de la FAT
	CP		0F8H
	JR		NZ,.COPY
	LD		HL,Dpb360
.COPY:
	LD		BC,18
	LDIR
	OR		A				;carry limpio
	RET

; Un DPB por formato, desde el media: son los 18 bytes de [HL+1..HL+18]. Los
; dos son de 3,5" y 80 pistas. El firmware lee por sector logico, asi que la
; geometria fisica (caras, sectores por pista) no aparece.
; Si se tocan, tocar tambien FMT720 y FMT360 en PAGE2.MAC.

DpbTable:
	db		0F9h	; media: 720 KB, doble faz
	dw		512		; bytes por sector
	db		0Fh		; mascara de directorio (16 entradas por sector)
	db		04h		; shift de directorio
	db		01h		; mascara de cluster (2 sectores por cluster)
	db		02h		; shift de cluster
	dw		1		; primer sector de la FAT
	db		2		; cantidad de FATs
	db		112		; entradas de directorio
	dw		14		; primer sector de datos
	dw		714		; clusters + 1
	db		3		; sectores por FAT
	dw		7		; primer sector del directorio

Dpb360:
	db		0F8h	; media: 360 KB, una cara
	dw		512
	db		0Fh
	db		04h
	db		01h
	db		02h
	dw		1
	db		2
	db		112
	dw		12
	dw		355
	db		2
	dw		5

;DEFDPB es el de 720 KB: el kernel lo copia en el DPB de cada drive al arrancar,
;antes del primer GETDPB, y con ese DPB lee la FAT.
;Apunta al media y no a DpbTable-1 como la plantilla de msxsyssrc: el INIT del
;kit ya resta 1 (LD HL,DEFDPB-1 para copiar los 21 bytes, LD A,(DEFDPB) para el
;media), asi que con DpbTable-1 la copia quedaba corrida un byte.
	PUBLIC	DEFDPB
DEFDPB		equ	DpbTable


; CHOICE
;
; Input: 	None
; Output:	HL	pointer to choice string, 0 if no choice
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Sin menu: una imagen DSK no cambia de largo, asi que DSKFMT la formatea
; segun el largo que ya tiene.

	PUBLIC	CHOICE
CHOICE:
	LD		HL,0
	RET


; DSKFMT
;
; Input: 	A	choicecode (1-9)
;		D	drivenumber
;		HL	begin of workarea
;		BC	length of workarea
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Formatea la imagen montada en el drive: la hace FORMAT en PAGE2.MAC. La
; eleccion no se usa, porque CHOICE no ofrece menu, ni el area de trabajo.

	PUBLIC	DSKFMT
DSKFMT:
	LD		A,D				;drive
	LD		IX,P2_FORMAT
				;sigue en CALLBOOT

; CALLBOOT
;
; Llama con CALLP2 a una entrada de la pagina 2 que escribe el sector de
; arranque (FORMAT, NEWDSK): le pasa la plantilla en HL y su largo en BC.

CALLBOOT:
	LD		HL,BOOTSEC
	LD		BC,NOTFIRST-0C000H	;largo de la plantilla: ver BOOTSEC, al final
				;sigue en CALLP2

; CALLP2
;
; Llama a la rutina de la pagina 2 cuya entrada esta en IX (P2_...). Pone la
; pagina 2 en el slot de este cartucho, llama, y la devuelve a la RAM. Pasa
; AF, BC, DE y HL, y devuelve los de la rutina: ENASLT destruye todo.
;
; Mientras la rutina corre, la RAM de la pagina 2 no se ve: nada de lo que
; la rutina necesite puede estar ahi. Ver PAGE2.MAC.

CALLP2:
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	PUSH	IX
	CALL	GETSLOT			;A = slot de este cartucho
	LD		H,80H
	CALL	ENASLT			;pagina 2 = esta EEPROM
	EI						;ENASLT deja las interrupciones cortadas
	POP		IX
	POP		AF
	POP		BC
	POP		DE
	POP		HL
	CALL	.JPIX
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	LD		A,(RAMAD2)
	LD		H,80H
	CALL	ENASLT			;pagina 2 = RAM otra vez
	EI
	POP		AF
	POP		BC
	POP		DE
	POP		HL
	RET
.JPIX:
	JP		(IX)



; OEMSTATEMENT
;
; Input:	HL	basicpointer
; Output:	F	Cx set if statement not recognized
;			Cx reset if statement is recognized
;		HL	basicpointer,	updated if recognized
;					unchanged if not recognized
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	OEMSTATEMENT
OEMSTATEMENT:
; BASIC CALL EXTENSION handler
	PUSH    HL
	LD		HL,CMDS	        ; Table with CALL extensions
.CHKCMD:
	LD		DE,PROCNM
.LOOP:		
	LD		A,(DE)
	CP		(HL)
	JR		NZ,.TONEXTCMD	; Not equal
	INC		DE
	INC		HL
	AND		A
	JR		NZ,.LOOP		; No end of command name, go checking
	LD		E,(HL)
	INC		HL
	LD		D,(HL)
	POP		HL				; routine address
	CALL	GETPREVCHAR
	CALL	.CALLDE			; Call routine
	AND		A
	RET

.TONEXTCMD:
	LD		C,0FFH
	XOR		A
	CPIR					; Skip to end of command name
	INC		HL
	INC		HL				; Skip address
	CP		(HL)
	JR		NZ,.CHKCMD		; Not end of table, go checking
	POP		HL
    SCF
	RET
	
.CALLDE:
	PUSH	DE
	RET

GETPREVCHAR:
	DEC		HL
	LD		IX,CHRGTR
	JP      CALBAS

;---------------------------
CMDS:
; List of available commands (as ASCIIZ) and execute address (as word)

	;diagnostico
	DEFB	"FFILES",0
	DEFW	_FFILES
	DEFB	"SDFTEST",0
	DEFW	_SDFTEST
	;SD e imagenes DSK
	DEFB	"SDFFILES",0
	DEFW	_SDFFILES
	DEFB	"SDFMOUNT",0
	DEFW	_SDFMOUNT
	DEFB	"SDFUMOUNT",0
	DEFW	_SDFUMOUNT
	DEFB	"SDFNEW",0
	DEFW	_SDFNEW
	DEFB	0               ; No more commands

PRINTHEX:
	PUSH	AF
	PUSH	AF
    CALL 	_Num1
	CALL	CHPUT
	POP		AF
	CALL 	_Num2
	CALL	CHPUT
	POP		AF
	RET  	; return with hex number in de
_Num1:
	RRA
	RRA
	RRA
	RRA
_Num2:       
	OR		0F0h
	DAA
	ADD 	A,0A0h
	ADC 	A,040h ; Ascii hex at this point (0 to F)   
	RET	

_FFILES:
	PUSH	HL
	LD		HL,$SECBUF
	LD		A,H
	CALL	PRINTHEX
	LD		A,L
	CALL	PRINTHEX
	LD		A,13
	CALL	CHPUT
	LD		A,10
	CALL	CHPUT
;	LD		HL,PR_LEN
;	LD		A,H
;	CALL	PRINTHEX
;	LD		A,L
;	CALL	PRINTHEX
	LD		A,13
	CALL	CHPUT
	LD		A,10
	CALL	CHPUT
;	LD		HL,PW_LEN
;	LD		A,H
;	CALL	PRINTHEX
;	LD		A,L
;	CALL	PRINTHEX
	LD		A,13
	CALL	CHPUT
	LD		A,10
	CALL	CHPUT
	POP		HL
	OR		A
	RET

; CALL SDFFILES
;
; Lista los .DSK de la raiz de la SD. No tiene argumentos: la hace entera
; SDFFILES en PAGE2.MAC.

_SDFFILES:
	LD		IX,P2_SDFFILES
	JP		CALLP2

; CALL SDFMOUNT(drive, "archivo")
;
; Monta una imagen DSK de la raiz de la SD en el drive indicado, 0=A 1=B.
; El firmware valida el pedido y contesta 0 si la monto, o directamente el
; numero de error de BASIC a mostrar: asi la ROM no carga con los mensajes.
; Queda en la pagina 1 porque el nombre puede estar en la RAM de la pagina 2.

_SDFMOUNT:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,GETBYT		;evalua el drive, 0-255 en A
	CALL	CALBAS
	PUSH	AF
	CALL	CHKCHAR
	DEFB	","             ; Check for ,
	LD		IX,FRMEVL		;evalua el nombre
	CALL	CALBAS
	LD      A,(VALTYP)
	CP      3               ; Text type?
	JP      NZ,TYPE_MISMATCH
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		AF				;drive
	PUSH	HL				;puntero de BASIC
	PUSH	AF
	LD		A,CMD_SDFMOUNT
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive
	CALL	GETSTRPNT		;HL=nombre, B=largo
	CALL	SENDNAME
SDFRESULT:							;final comun de SDFMOUNT y SDFUMOUNT
	CALL	ReadByte		;0=ok, si no el numero de error de BASIC
SDFERROR:							;SDFNEW entra aca, con el resultado en A
	POP		HL				;puntero de BASIC
	OR		A
	RET		Z
	LD		E,A
	LD		IX,ERRHAND		; Call the Basic error handler
	JP		CALBAS

; CALL SDFUMOUNT(drive)
;
; Desmonta la imagen del drive indicado, 0=A 1=B. El drive queda vacio, tambien
; despues de apagar, y el DOS contesta "Disk offline" hasta el proximo SDFMOUNT.

_SDFUMOUNT:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,GETBYT		;evalua el drive, 0-255 en A
	CALL	CALBAS
	PUSH	AF
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		AF				;drive
	PUSH	HL				;puntero de BASIC
	PUSH	AF
	LD		A,CMD_SDFUMOUNT
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive
	JR		SDFRESULT

; CALL SDFNEW("archivo"[, tamaño])
;
; Crea en la raiz de la SD una imagen DSK en blanco y formateada, de 720 o de
; 360 KB segun el tamaño (sin tamaño, 720). No la monta. Si el nombre no tiene
; extension, el firmware le agrega .DSK.
; Aca solo se leen los argumentos y se manda el pedido, porque el nombre puede
; estar en la RAM de la pagina 2. La espera y el formateo los hace NEWDSK en
; PAGE2.MAC.

_SDFNEW:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,FRMEVL		;evalua el nombre
	CALL	CALBAS
	LD      A,(VALTYP)
	CP      3               ; Text type?
	JP      NZ,TYPE_MISMATCH
	LD		DE,(USR)		;descriptor del nombre: evaluar el tamaño pisa USR
	PUSH	DE
	CALL	GETPREVCHAR		;A = proximo caracter
	LD		E,MEDIA_720K	;sin tamaño, 720 KB
	CP		","
	JR		NZ,.NEWCLOSE
	CALL	CHKCHAR
	DEFB	","             ; Check for ,
	LD		IX,FRMQNT		;evalua el tamaño, entero en DE
	CALL	CALBAS
	PUSH	HL				;puntero de BASIC
	EX		DE,HL			;HL = tamaño
	LD		E,MEDIA_720K
	LD		BC,720
	OR		A
	SBC		HL,BC
	JR		Z,.NEWSIZE
	LD		E,MEDIA_360K
	LD		BC,360-720		;HL tiene tamaño-720
	OR		A
	SBC		HL,BC
	JP		NZ,ILLEGAL_FUNCTION	;ni 720 ni 360
.NEWSIZE:
	POP		HL
.NEWCLOSE:
	PUSH	DE				;E = media
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		DE
	POP		BC				;descriptor del nombre
	PUSH	HL				;puntero de BASIC
	LD		A,CMD_SDFNEW
	CALL	WriteCommand
	LD		A,E
	CALL	WriteByte		;media: el tamaño
	LD		H,B
	LD		L,C
	CALL	STRDESC			;HL=nombre, B=largo
	CALL	SENDNAME
	LD		IX,P2_NEWDSK	;espera al firmware y formatea la imagen
	CALL	CALLBOOT		;A = 0 o el numero de error de BASIC
	JP		SDFERROR

; CALL SDFTEST
;
; Diagnostico: verifica que el firmware conteste y que hable el mismo protocolo
; que esta ROM. No tiene argumentos: lo hace entero SDFTEST en PAGE2.MAC.

_SDFTEST:
	LD		IX,P2_SDFTEST
	JP		CALLP2
	
; MTOFF
;
; Input:	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	MTOFF
MTOFF:
	PUSH	AF
	LD		A,CMD_MTOFF
	CALL	WriteCommand
	POP		AF
	RET

;---------------------------
GETSTRPNT:
; OUT:
; HL = String Address
; B  = Lenght

	LD      HL,(USR)
STRDESC:					;lo mismo, con el descriptor en HL
	LD      B,(HL)
	INC     HL
	LD      E,(HL)
	INC     HL
	LD      D,(HL)
	EX      DE,HL
	RET

; Le manda al firmware el largo y el nombre: HL=nombre, B=largo
SENDNAME:
	LD		A,B
	CALL	WriteByte		;largo
	OR		A
	RET		Z
.SENDCHAR:
	LD		A,(HL)
	CALL	WriteByte
	INC		HL
	DJNZ	.SENDCHAR
	RET

CHKCHAR:
	CALL	GETPREVCHAR		; Get previous basic char
	EX		(SP),HL
	CP		(HL) 	        ; Check if good char
	JR		NZ,SYNTAX_ERROR	; No, Syntax error
	INC		HL
	EX		(SP),HL
	INC		HL				; Get next basic char
	JP		GETPREVCHAR		;sin esto caia en TYPE_MISMATCH

ILLEGAL_FUNCTION:
	LD		E,5
	DB		1				;LD BC,nn: saltea el LD E siguiente

TYPE_MISMATCH:
	LD      E,13
	DB      1

SYNTAX_ERROR:
	LD      E,2
	LD		IX,ERRHAND		; Call the Basic error handler
	JP		CALBAS

; BOOTSEC
;
; Plantilla del sector de arranque que escriben DSKFMT y CALL SDFNEW: el
; BOOT.Z80 del kit de ASCII, el codigo que carga MSXDOS.SYS. Queda en la pagina
; 1, con el resto del kit, para que la pagina 2 no lleve codigo de terceros.
; FORMAT (PAGE2.MAC) le completa el BPB, bytes 0Bh-1Dh, segun el formato.
;
; Va AL FINAL a proposito: el END de BOOT.Z80 termina el ensamblado de este
; archivo, asi que nada de lo que siguiera al INCLUDE se ensamblaria. Por lo
; mismo el largo sale de NOTFIRST, la ultima etiqueta de BOOT.Z80: es una
; variable de un byte que no hace falta grabar. El Makefile pasa -id build.

BOOTSEC:
	INCLUDE	BOOT.Z80
