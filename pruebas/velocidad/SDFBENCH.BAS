10 REM SDFBENCH - velocidad de disco del SDF-1
20 REM Escribe y lee 8 veces 16 KB (BSAVE/BLOAD) y hace 64 GET al azar
30 REM Agrega cada corrida a RESULT.TXT: etiqueta,KB/s escritura,KB/s lectura,ms por GET,errores
40 H=PEEK(&HFC4A)+256*PEEK(&HFC4B):IF H<&HD820 THEN PRINT"HIMEM muy bajo: ";HEX$(H):END
50 CLEAR 300,&H9800
60 DEFINT A,D,E,F,I,M,N:DEF FNR(X)=INT(X*10+.5)/10
70 F=60:IF PEEK(&H2B) AND 128 THEN F=50
80 N=8:M=64
90 FOR I=0 TO 11:READ D:POKE &HD800+I,D:NEXT
100 FOR I=0 TO 13:READ D:POKE &HD810+I,D:NEXT
110 DEFUSR0=&HD800:DEFUSR1=&HD810
120 REM USR0: copia la BIOS (0000-3FFF) a 9800-D7FF
130 DATA 33,0,0,17,0,152,1,0,64,237,176,201
140 REM USR1: llena 9800-D7FF con ceros
150 DATA 33,0,152,17,1,152,1,255,63,54,0,237,176,201
160 ON ERROR GOTO 900
170 PRINT"SDFBENCH - velocidad del disco (";F;"Hz)":PRINT
180 INPUT"Etiqueta (ej. v0.2)";L$
190 X=USR0(0)
200 PRINT"Escritura";N*16;"KB...";:TIME=0
210 FOR I=1 TO N:BSAVE"BENCH.BIN",&H9800,&HD7FF:NEXT
220 TW!=TIME:PRINT FNR(N*16*F/TW!);"KB/s"
230 X=USR1(0)
240 PRINT"Lectura";N*16;"KB...";:TIME=0
250 FOR I=1 TO N:BLOAD"BENCH.BIN":NEXT
260 TR!=TIME:PRINT FNR(N*16*F/TR!);"KB/s"
270 E=0:FOR A=0 TO &H3FFF STEP 31:IF PEEK(A)<>PEEK(A+&H9800) THEN E=E+1
280 NEXT
290 IF E THEN PRINT"Verificacion:";E;"ERRORES" ELSE PRINT"Verificacion: OK"
300 PRINT"Al azar";M;"GET...";:OPEN"BENCH.BIN" AS #1 LEN=128:FIELD #1,128 AS B$
310 TIME=0:FOR I=1 TO M:GET #1,(I*37 MOD 128)+1:NEXT
320 TG!=TIME:CLOSE #1:PRINT FNR(TG!*1000/F/M);"ms por GET"
330 KILL"BENCH.BIN"
340 OPEN"RESULT.TXT" FOR APPEND AS #1
350 PRINT #1,L$;",";FNR(N*16*F/TW!);",";FNR(N*16*F/TR!);",";FNR(TG!*1000/F/M);",";E
360 CLOSE #1:PRINT:PRINT"Guardado en RESULT.TXT"
370 END
900 IF ERR=53 AND ERL=340 THEN OPEN"RESULT.TXT" FOR OUTPUT AS #1:RESUME 350
910 ON ERROR GOTO 0:PRINT"Error";ERR;"en linea";ERL:END
