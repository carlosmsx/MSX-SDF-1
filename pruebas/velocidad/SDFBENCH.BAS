10 REM SDFBENCH - velocidad de disco del SDF-1
20 REM Escribe y lee N veces 16 KB (BSAVE/BLOAD) y hace M GET al azar
30 REM Mide con RTC: porque TIME no cuenta mientras se accede al disco
40 REM Agrega a RESULT.TXT: etiqueta,KB/s escritura,KB/s lectura,ms por GET,errores,reloj
50 H=PEEK(&HFC4A)+256*PEEK(&HFC4B):IF H<&HD820 THEN PRINT"HIMEM muy bajo: ";HEX$(H):END
55 POKE &HD81E,H-256*INT(H/256):POKE &HD81F,INT(H/256):REM HIMEM original, lo repone la linea 950
60 CLEAR 300,&H9800:MAXFILES=2
70 DEFINT A,D,E,F,I,M,N:DEF FNR(X)=INT(X*10+.5)/10
80 F=60:IF PEEK(&H2B) AND 128 THEN F=50
90 N=32:M=256
100 FOR I=0 TO 11:READ D:POKE &HD800+I,D:NEXT
110 FOR I=0 TO 13:READ D:POKE &HD810+I,D:NEXT
120 DEFUSR0=&HD800:DEFUSR1=&HD810
130 REM USR0: copia la BIOS (0000-3FFF) a 9800-D7FF
140 DATA 33,0,0,17,0,152,1,0,64,237,176,201
150 REM USR1: llena 9800-D7FF con ceros
160 DATA 33,0,152,17,1,152,1,255,63,54,0,237,176,201
170 ON ERROR GOTO 900
180 PRINT"SDFBENCH - velocidad del disco":PRINT
190 C$="RTC":OPEN"RTC:N" FOR INPUT AS #2:IF EOF(2) THEN CLOSE #2:C$="TIME"
200 IF C$="TIME" THEN PRINT"Sin reloj: mide con TIME y da de mas":PRINT
210 INPUT"Etiqueta (ej. v0.2)";L$
220 X=USR0(0)
230 PRINT"Escritura";N*16;"KB...";:GOSUB 700
240 FOR I=1 TO N:BSAVE"BENCH.BIN",&H9800,&HD7FF:NEXT
250 GOSUB 750:TW=T:PRINT FNR(N*16/TW);"KB/s"
260 X=USR1(0)
270 PRINT"Lectura";N*16;"KB...";:GOSUB 700
280 FOR I=1 TO N:BLOAD"BENCH.BIN":NEXT
290 GOSUB 750:TR=T:PRINT FNR(N*16/TR);"KB/s"
300 E=0:FOR A=0 TO &H3FFF STEP 31:IF PEEK(A)<>PEEK(A+&H9800) THEN E=E+1
310 NEXT
320 IF E THEN PRINT"Verificacion:";E;"ERRORES" ELSE PRINT"Verificacion: OK"
330 PRINT"Al azar";M;"GET...";:OPEN"BENCH.BIN" AS #1 LEN=128:FIELD #1,128 AS B$:GOSUB 700
340 FOR I=1 TO M:GET #1,((I*37) MOD 128)+1:NEXT
350 GOSUB 750:TG=T:CLOSE #1:PRINT FNR(TG*1000/M);"ms por GET"
360 KILL"BENCH.BIN":IF C$="RTC" THEN CLOSE #2
370 OPEN"RESULT.TXT" FOR APPEND AS #1
380 PRINT #1,L$;",";FNR(N*16/TW);",";FNR(N*16/TR);",";FNR(TG*1000/M);",";E;",";C$
390 CLOSE #1:PRINT:PRINT"Guardado en RESULT.TXT"
400 GOTO 950
700 REM Arranque: espera el cambio de segundo, T0 = segundo del dia
710 IF C$="TIME" THEN TIME=0:RETURN ELSE GOSUB 850:T0=S:RETURN
750 REM Fin: T = segundos desde el arranque. TIME mide solo la espera final, sin disco
760 IF C$="TIME" THEN T=TIME/F:RETURN
770 GOSUB 850:T=S-T0-TIME/F:IF T<0 THEN T=T+86400!
780 RETURN
800 INPUT #2,Y,MO,D,HH,MI,S,W$:S=HH*3600!+MI*60+S:RETURN
850 REM Espera a que cambie el segundo; deja en TIME lo que espero
860 TIME=0:GOSUB 800:S0=S
870 GOSUB 800:IF S<>S0 THEN RETURN
880 IF TIME>3*F THEN PRINT:PRINT"El reloj no avanza":GOTO 950
890 GOTO 870
900 IF ERL=190 THEN C$="TIME":RESUME 200
910 IF ERR=53 AND ERL=370 THEN OPEN"RESULT.TXT" FOR OUTPUT AS #1:RESUME 380
920 PRINT"Error";ERR;"en linea";ERL:RESUME 950
930 REM Con la pila en la pagina 2 se cuelgan los CALL SDF que usan la pagina 2 de la ROM
950 CLEAR 200,PEEK(&HD81E)+256*PEEK(&HD81F):END
