	TITLE   DSKDRV - MSXDOS disk driver for MSX-IoT hardware -
	.Z80
	
;How to compile:
;  1) RunCPM
;  1.1) M80 =dskdrv.mac
;  1.2) l80 /p:4000,/d:f237,doshead,bios,msxdos,smldisp,init,dskbasic,msxdata,dskdrv,basdata,msxdos/n/x/y/e
;  2) hex2bin -e rom -l 4000 a\0\msxdos.hex

;28815 - 23438 = 5377
;28815 - 26510 = 2305

; External variables & routines
CHPUT   	EQU     000A2H
CALBAS		EQU		00159H
ERRHAND 	EQU     0406FH
FRMEVL  	EQU     04C64H
FRMQNT		EQU		0542FH			;evalua una expresion entera, la deja en DE
CHRGTR  	EQU     04666H
VALTYP  	EQU     0F663H
USR     	EQU     0F7F8H
PROCNM		EQU		0FD89H
PTRFIL		EQU		0F864H			;puntero al FCB del archivo en uso
FILNAM		EQU		0F866H			;nombre 8.3, 11 bytes con espacios
DEVICE		EQU		0FD99H			;ID del dispositivo que BASIC esta llamando
PUTINT		EQU		02E9AH			;A con signo -> DAC, para el EOF
GETBYT		EQU		0521CH
;ENASLT  	EQU     00024H          ;enable slot
;RSLREG  	EQU     00138H          ;read primary slot select register
;RSLGREG 	EQU		00138H
;BOTTOM		EQU		0FC48H
;HIMEM		EQU		0FC4AH
;SLTWRK		EQU		0FD09H
;EXPTBL  	EQU     0FCC1H          ;slot is expanded or not
;CALSLT		EQU		0001CH

; symbols which can be used from the kernel

; GETSLT	get my slotid
; DIV16		divide

EXTRN		GETWRK          ;get base  of  work  area  in  [IX]  and
							;[HL]
; SETINT	install my interrupt handler
; PRVINT	call orginal interrupt handler
EXTRN		SETINT,PRVINT
; PROMPT	prompt for phantom drive
; RAWFLG	verify flag
; $SECBUF	temporary sectorbuffer (no se usa: lo pedia CALL FFILES)
; GETSLOT	slot del cartucho, para poner la pagina 2 (ver CALLP2)
; ENASLT	habilita un slot en una pagina
; RAMAD2	slot de la RAM de la pagina 2
EXTRN		GETSLOT,ENASLT,RAMAD2
; XFER		transfer to TPA
; DISINT	inform interrupts are being disabled
; ENAINT	inform interrupts are being enabled
;EXTRN		PROCNM			;CALL statement name

; Variables y rutina de fecha/hora del kernel, para el parche del reloj
; (MYCHKCLK/MYGETTI/MYSETDA/MYSETTI, camino A de reloj-cuatro-caminos.md).
; Las direcciones las resuelve el linker: nunca se hardcodean (mismo criterio
; que OEMDEV, ver entrada-device-verificada).
; TIMFLG	0 = no hay reloj; lo pone MYCHKCLK
; CURDAT	contador de dias del kernel, lo actualiza MYSETDA
; DAY/MONTH	fecha en RAM (dia y mes del mes en curso), en binario
; YEAR		anio en RAM, en binario, contado desde 1980
; SETYEA	setea YEAR y ajusta MONTAB para febrero (28/29 dias)
EXTRN		TIMFLG,CURDAT,DAY,MONTH,YEAR,SETYEA

; symbols which must be defined by the driver

; INIHRD	initialize diskdriver hardware
; DRIVES	how many drives are connected
; INIENV	initialize diskdriver workarea
; DSKIO		diskdriver sector i/o
; DSKCHG	diskdriver diskchange status
; GETDPB	build Drive Parameter Block
; CHOICE	get format choice string
; DSKFMT	format disk
; MTOFF		stop diskmotor
; OEMSTA	diskdriver special call statements

; MYSIZE	size of diskdriver workarea
; SECLEN	size of biggest sector supported by the diskdriver
; DEFDPB	pointer to a default Drive Parameter Block



; errorcodes used by DSKIO, DSKCHG and GETDPB
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	other error

; errorcodes used by DSKFMT
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	bad parameter
; 14	insufficient memory
; 16	other error

	PUBLIC	MYSIZE
MYSIZE		equ	1		; Size of environment
	PUBLIC	SECLEN
SECLEN		equ	512		; Size of biggest sector

;----Protocolo con el firmware: comandos, respuestas y puertos----
	INCLUDE	PROTOCOL.INC

;----Pagina 2----
;Entradas de la tabla de saltos de PAGE2.MAC, que empieza en 8000h. El orden
;es el contrato entre los dos archivos. Se llaman con CALLP2.
P2_FORMAT	EQU		8000H
P2_NEWDSK	EQU		8003H
P2_SDFFILES	EQU		8006H
P2_SDFTEST	EQU		8009H

WriteByte:
	OUT		(PORT_DATA),A
	EX 		(SP),HL		;19 cycles
	EX		(SP),HL		;19 cycles
	RET

WriteCommand:
	OUT		(PORT_CMD),A
	EX		(SP),HL
	EX		(SP),HL
	RET

WriteBlock:
	OUTI
	EX		(SP),HL
	EX		(SP),HL
	JR		NZ,WriteBlock
	RET

ReadByte:
	IN		A,(PORT_DATA)
	EX		(SP),HL
	EX		(SP),HL
	RET

ReadBlock:
	IN		D,(C)
	LD		(HL),D
	XOR		D		; CHECKSUM XOR8 EN EL ACUMULADOR
	INC		HL
	EX		(SP),HL
	EX		(SP),HL
	DJNZ	ReadBlock
	RET

;----Reloj: MYCHKCLK/MYGETTI/MYSETDA/MYSETTI----
;
; Reemplazan a CHKCLK/$GETTI/$SETDA/$SETTI del kernel (parcheadas con JP por
; tools/patch_rtc_kernel.py despues del link). Camino A de
; reloj-cuatro-caminos.md: en vez de emular el RP-5C01 en B4h/B5h (que fallaba
; por timing en el bucle de deteccion, el acceso mas apretado de toda la ROM),
; hablan con el firmware por el protocolo normal de comando+datos, con el
; mismo margen (los EX (SP),HL de WriteByte/WriteCommand/ReadByte) que ya usa
; el resto del sistema en hardware. Los contratos de entrada/salida son los
; que documenta reloj-capa-rp5c01-en-el-kit.md, verificados por desensamblado
; de las rutinas originales.

	PUBLIC	MYCHKCLK,MYGETTI,MYSETDA,MYSETTI

; MYCHKCLK: sondea el reloj. Sale con TIMFLG en 0FFh si contesta, 0 si no.
; Sin parametros de entrada ni de salida (igual que CHKCLK original).
MYCHKCLK:
	LD		A,CMD_RTCCHK
	CALL	WriteCommand
	CALL	ReadByte
	LD		(TIMFLG),A
	RET

; MYGETTI: lee el reloj.
; Sale: B=hora(0-23), C=minuto, D=segundo, todo binario; DAY/MONTH puestos,
; YEAR seteado via SETYEA. Carry=1 si hay reloj.
; Sin reloj: B=C=D=E=0, HL=(CURDAT), carry=0. (E no se usa mas adelante en el
; kernel, pero se preserva el contrato exacto del original.)
MYGETTI:
	LD		A,(TIMFLG)
	LD		B,A
	LD		C,A
	LD		D,A
	LD		E,A
	LD		HL,(CURDAT)
	OR		A
	RET		Z				;TIMFLG=0: sin reloj, carry ya en 0 por el OR A

	LD		A,CMD_RTCGET
	CALL	WriteCommand
	CALL	ReadByte		;anio-1980
	CALL	SETYEA
	CALL	ReadByte		;mes
	LD		(MONTH),A
	CALL	ReadByte		;dia
	LD		(DAY),A
	CALL	ReadByte		;hora
	LD		B,A
	CALL	ReadByte		;minuto
	LD		C,A
	CALL	ReadByte		;segundo
	LD		D,A
	CALL	ReadByte		;dia de semana: el kernel no lo usa, se lee para
						;vaciar el protocolo (7 bytes por CMD_RTCGET)
	SCF
	RET

; MYSETDA: escribe fecha (BDOS 2Bh, SETDAT).
; Entra con HL = nuevo contador de dias (CURDAT). Usa YEAR/MONTH/DAY de RAM,
; que el kernel ya actualizo antes de llamar a $SETDA.
MYSETDA:
	LD		(CURDAT),HL
	LD		A,(TIMFLG)
	AND		A
	RET		Z

	LD		A,CMD_RTCSETDA
	CALL	WriteCommand
	LD		A,(YEAR)
	CALL	WriteByte
	LD		A,(MONTH)
	CALL	WriteByte
	LD		A,(DAY)
	CALL	WriteByte
	RET

; MYSETTI: escribe hora (BDOS 2Dh, SETTIM).
; Entra con B=hora, C=minuto, D=segundo, todo binario (asi los arma SETTIM
; antes de llamar a $SETTI: los compara contra 18h/3Bh/3Bh, limites en
; decimal, asi que no pueden ser BCD).
MYSETTI:
	LD		A,(TIMFLG)
	AND		A
	RET		Z

	LD		A,CMD_RTCSETTI
	CALL	WriteCommand
	LD		A,B
	CALL	WriteByte		;hora
	LD		A,C
	CALL	WriteByte		;minuto
	LD		A,D
	CALL	WriteByte		;segundo
	RET

; INIHRD
;
; Input:	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	INIHRD
INIHRD:
	LD		A,CMD_INIHRD
	CALL	WriteCommand
	RET

; DRIVES
;
; Input: 	F	Zx set if to return physical drives
;			Zx reset if to return at least 2 drives, if only one
;			  physical drive it becomes a phantom drive
; Output:	L	number of drives
; Changed:	F,HL,IX,IY may be affected
;
; Remark:	DOS1 does not handle L=0 correctly

	PUBLIC	DRIVES
DRIVES:
	PUSH	AF
	LD		A,CMD_DRIVES
	CALL	WriteCommand
	POP		AF
	LD		L,2
	RET

; INIENV
;
; Input: 	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Remark:	examples installs own interrupt handler, but this is NOT required.
;		depends on the hardware if this is needed.

	PUBLIC	INIENV
INIENV:
	PUSH	AF
	LD		A,CMD_INIENV
	CALL	WriteCommand
	POP		AF
	
	RET		;do nothing
	
	CALL	GETWRK
	LD		(HL),1
	LD		HL,INTHAND
	JP		SETINT

INTHAND:	
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	IX
	PUSH	IY
	CALL	GETWRK
	INC		(HL)
	POP		IY
	POP		IX
	POP		HL
	POP		DE
	POP		BC
	POP		AF
	JP		PRVINT

;
; DSKIO
;
; Input: 	A	Drivenumber
;		F	Cx reset for read
;			Cx set for write
; 		B	number of sectors
; 		C	Media descriptor
;		DE	logical sectornumber
; 		HL	transferaddress
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if error, remaining sectors
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	DSKIO
DSKIO:
	PUSH	AF
	JP      NC,READ         ;if no carry, we should read
WRITE:
	LD		A,CMD_WRITE		;write
	CALL	WriteCommand
	POP		AF				;drive number
	CALL	WriteByte
	LD		A,B				;n-sectors
	CALL	WriteByte
	LD		A,C				;media
	CALL	WriteByte
	LD		A,H
	CALL	WriteByte
	LD		A,L
	CALL	WriteByte
	LD		A,D				;sec Hi
	CALL	WriteByte
	LD		A,E				;sec Lo
	CALL	WriteByte
	CALL	ReadByte		;estado: 0 ok, si no el error de DSKIO
	OR		A
	JR		NZ,DSKIOERROR
	LD		D,B				;store n-sectors ;/\
WRSEC:
	PUSH	BC				;only B matters
	LD		BC,0			;B=0 to count until 256, C=0 for OUTI
	CALL	WriteBlock		;256 bytes
	CALL	WriteBlock		;256 bytes
	POP		BC
	DJNZ	WRSEC			;relative jump
	LD		B,D				;restore n-sectors ;/\
	SCF
	CCF						;no errors
	RET
	
DSKIOERROR:
	SCF						;A=error code, B=remaining sectors (todos)
	RET

READ:
	LD		A,CMD_READ		;read
	CALL	WriteCommand
	POP		AF				;drive number
	CALL	WriteByte		
	LD		A,B				;n-sectors
	CALL	WriteByte		
	LD		A,C				;media
	CALL	WriteByte
	LD		A,H
	CALL	WriteByte
	LD		A,L
	CALL	WriteByte
	LD		A,D				;sec H
	CALL	WriteByte
	LD		A,E				;sec L
	CALL	WriteByte
	CALL	ReadByte		;estado: 0 ok, si no el error de DSKIO
	OR		A
	JR		NZ,DSKIOERROR
RDSEC:
	PUSH	BC				;only B matters
	LD		BC,0			;B=0 to count until 256 bytes, C=0 for INI
	XOR		A				;calculated checksum
	CALL	ReadBlock		;256 bytes
	CALL	ReadBlock		;256 bytes
	;INC		C				;C=1
	
	PUSH	AF
	LD		A,CMD_DEBUG
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte
	
	;IN		D,(C)			;remote checksum
	POP		BC
	;CP		D				;compare checksums
	;JR		Z,RDS_CONTINUE
	;SCF
	;LD		A,4				;checksum error
	;RET
RDS_CONTINUE:
	DJNZ	RDSEC			;relative jump
	;ld		a,12
	SCF
	CCF						;no errors
	RET


; DSKCHG
;
; Input: 	A	Drivenumber
; 		B	0
; 		C	Media descriptor
; 		HL	pointer to DPB
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if no error, disk change status
;			01 disk unchanged
;			00 unknown
;			FF disk changed
; Changed:	AF,BC,DE,HL,IX,IY may be affected
; Remark:	DOS1 kernel expects the DPB updated when disk change status is unknown or changed
;		DOS2 kernel does not care if the DPB is updated or not

	PUBLIC	DSKCHG
DSKCHG:
	PUSH	AF
	LD		A,CMD_DSKCHG
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive number
	CALL	ReadByte		;01 sin cambio, FF cambiado por CALL SDFMOUNT
	LD		B,A
	INC		A
	JR		NZ,.NOCHANGE
	PUSH	BC
	CALL	GETDPB			;con FF, DOS1 espera el DPB actualizado en [HL]
	POP		BC
.NOCHANGE:
	OR		A				;no errors
	RET

; GETDPB
;
; Input: 	A	Drivenumber
; 		B	first byte of FAT
; 		C	Media descriptor
; 		HL	pointer to DPB
; Output:	[HL+1]
;		..
;		[HL+18]	updated
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	GETDPB
;
; El kernel de DOS1 lee la FAT despues de un DSKCHG con cambio y llama aca con
; su primer byte en B: F8 es un 360 KB, cualquier otra cosa se toma como
; 720 KB. Desde nuestro DSKCHG llega B=FF, antes de que el kernel lea la FAT:
; ese DPB de 720 KB dura hasta que el kernel vuelve a llamar con el byte real.

GETDPB:
	PUSH	AF
	LD		A,CMD_GETDPB
	CALL	WriteCommand
	POP		AF
	EX		DE,HL		;porque no existe LD DE,HL
	INC		DE
	LD		HL,DpbTable		;720 KB
	LD		A,B				;primer byte de la FAT
	CP		0F8H
	JR		NZ,.COPY
	LD		HL,Dpb360
.COPY:
	LD		BC,18
	LDIR
	OR		A				;carry limpio
	RET

; Un DPB por formato, desde el media: son los 18 bytes de [HL+1..HL+18]. Los
; dos son de 3,5" y 80 pistas. El firmware lee por sector logico, asi que la
; geometria fisica (caras, sectores por pista) no aparece.
; Si se tocan, tocar tambien FMT720 y FMT360 en PAGE2.MAC.

DpbTable:
	db		0F9h	; media: 720 KB, doble faz
	dw		512		; bytes por sector
	db		0Fh		; mascara de directorio (16 entradas por sector)
	db		04h		; shift de directorio
	db		01h		; mascara de cluster (2 sectores por cluster)
	db		02h		; shift de cluster
	dw		1		; primer sector de la FAT
	db		2		; cantidad de FATs
	db		112		; entradas de directorio
	dw		14		; primer sector de datos
	dw		714		; clusters + 1
	db		3		; sectores por FAT
	dw		7		; primer sector del directorio

Dpb360:
	db		0F8h	; media: 360 KB, una cara
	dw		512
	db		0Fh
	db		04h
	db		01h
	db		02h
	dw		1
	db		2
	db		112
	dw		12
	dw		355
	db		2
	dw		5

;DEFDPB es el de 720 KB: el kernel lo copia en el DPB de cada drive al arrancar,
;antes del primer GETDPB, y con ese DPB lee la FAT.
;Apunta al media y no a DpbTable-1 como la plantilla de msxsyssrc: el INIT del
;kit ya resta 1 (LD HL,DEFDPB-1 para copiar los 21 bytes, LD A,(DEFDPB) para el
;media), asi que con DpbTable-1 la copia quedaba corrida un byte.
	PUBLIC	DEFDPB
DEFDPB		equ	DpbTable


; CHOICE
;
; Input: 	None
; Output:	HL	pointer to choice string, 0 if no choice
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Sin menu: una imagen DSK no cambia de largo, asi que DSKFMT la formatea
; segun el largo que ya tiene.

	PUBLIC	CHOICE
CHOICE:
	LD		HL,0
	RET


; DSKFMT
;
; Input: 	A	choicecode (1-9)
;		D	drivenumber
;		HL	begin of workarea
;		BC	length of workarea
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
; Changed:	AF,BC,DE,HL,IX,IY may be affected
;
; Formatea la imagen montada en el drive: la hace FORMAT en PAGE2.MAC. La
; eleccion no se usa, porque CHOICE no ofrece menu, ni el area de trabajo.

	PUBLIC	DSKFMT
DSKFMT:
	LD		A,D				;drive
	LD		IX,P2_FORMAT
				;sigue en CALLBOOT

; CALLBOOT
;
; Llama con CALLP2 a una entrada de la pagina 2 que escribe el sector de
; arranque (FORMAT, NEWDSK): le pasa la plantilla en HL y su largo en BC.

CALLBOOT:
	LD		HL,BOOTSEC
	LD		BC,NOTFIRST-0C000H	;largo de la plantilla: ver BOOTSEC, al final
				;sigue en CALLP2

; CALLP2
;
; Llama a la rutina de la pagina 2 cuya entrada esta en IX (P2_...). Pone la
; pagina 2 en el slot de este cartucho, llama, y la devuelve a la RAM. Pasa
; AF, BC, DE y HL, y devuelve los de la rutina: ENASLT destruye todo.
;
; Mientras la rutina corre, la RAM de la pagina 2 no se ve: nada de lo que
; la rutina necesite puede estar ahi. Ver PAGE2.MAC.

CALLP2:
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	PUSH	IX
	CALL	GETSLOT			;A = slot de este cartucho
	LD		H,80H
	CALL	ENASLT			;pagina 2 = esta EEPROM
	EI						;ENASLT deja las interrupciones cortadas
	POP		IX
	POP		AF
	POP		BC
	POP		DE
	POP		HL
	CALL	.JPIX
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	LD		A,(RAMAD2)
	LD		H,80H
	CALL	ENASLT			;pagina 2 = RAM otra vez
	EI
	POP		AF
	POP		BC
	POP		DE
	POP		HL
	RET
.JPIX:
	JP		(IX)



; OEMSTATEMENT
;
; Input:	HL	basicpointer
; Output:	F	Cx set if statement not recognized
;			Cx reset if statement is recognized
;		HL	basicpointer,	updated if recognized
;					unchanged if not recognized
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	OEMSTATEMENT
OEMSTATEMENT:
; BASIC CALL EXTENSION handler
	PUSH    HL
	LD		HL,CMDS	        ; Table with CALL extensions
.CHKCMD:
	LD		DE,PROCNM
.LOOP:		
	LD		A,(DE)
	CP		(HL)
	JR		NZ,.TONEXTCMD	; Not equal
	INC		DE
	INC		HL
	AND		A
	JR		NZ,.LOOP		; No end of command name, go checking
	LD		E,(HL)
	INC		HL
	LD		D,(HL)
	POP		HL				; routine address
	CALL	GETPREVCHAR
	CALL	.CALLDE			; Call routine
	AND		A
	RET

.TONEXTCMD:
	LD		C,0FFH
	XOR		A
	CPIR					; Skip to end of command name
	INC		HL
	INC		HL				; Skip address
	CP		(HL)
	JR		NZ,.CHKCMD		; Not end of table, go checking
	POP		HL
    SCF
	RET
	
.CALLDE:
	PUSH	DE
	RET

GETPREVCHAR:
	DEC		HL
	LD		IX,CHRGTR
	JP      CALBAS

;---------------------------
CMDS:
; List of available commands (as ASCIIZ) and execute address (as word)

	;diagnostico
	DEFB	"SDFTEST",0
	DEFW	_SDFTEST
	DEFB	"SDFDEBUG",0
	DEFW	_SDFDEBUG
	;SD e imagenes DSK
	DEFB	"SDFFILES",0
	DEFW	_SDFFILES
	DEFB	"SDFMOUNT",0
	DEFW	_SDFMOUNT
	DEFB	"SDFUMOUNT",0
	DEFW	_SDFUMOUNT
	DEFB	"SDFNEW",0
	DEFW	_SDFNEW
	;reloj
	DEFB	"RTC",0
	DEFW	_RTC
	DEFB	0               ; No more commands

; CALL SDFDEBUG
;
; Imprime lo que el firmware haya dejado en su buffer de depuracion, hasta el 0
; final, y lo vacia. Es para mandar texto desde el ATmega mientras se prueba
; algo: alla se escribe con dbg("lo que sea"). Sin mensajes no imprime nada.
;
; Reemplazo de CALL FFILES, que imprimia la direccion de enlace de $SECBUF y
; tres lineas en blanco, y ya no le servia a nadie.

_SDFDEBUG:
	PUSH	HL				;puntero de BASIC
	LD		A,CMD_SDFDEBUG
	CALL	WriteCommand
	LD		B,0				;tope de 256: sin firmware el bus flotando no termina
.DBGCHAR:
	CALL	ReadByte
	OR		A
	JR		Z,.DBGEND
	PUSH	BC
	CALL	CHPUT
	POP		BC
	DJNZ	.DBGCHAR
.DBGEND:
	POP		HL
	OR		A
	RET

; CALL RTC
; CALL RTC("2026-09-20 19:05:00")
;
; Sin argumento muestra la fecha y la hora; con un texto pone el reloj. Las dos
; usan el mismo tubo que OPEN "RTC:" (dispositivo 0), asi que el formato de
; salida y el parseo de la fecha siguen viviendo en el firmware: esto es solo
; comodidad para el prompt.

_RTC:
	CP		"("				;OEMSTATEMENT ya dejo el caracter actual en A
	JR		Z,_RTCSET

	PUSH	HL				;puntero de BASIC
	LD		E,1				;FOR INPUT
	CALL	RTCOPEN
	LD		B,40			;la linea mas larga que arma el firmware son 22
.RTCCHAR:
	LD		A,CMD_DEVIN
	CALL	WriteCommand
	CALL	ReadByte
	OR		A
	JR		Z,.RTCEND			;fin de datos
	CP		13
	JR		Z,.RTCEND			;fin de linea
	PUSH	BC
	CALL	CHPUT
	POP		BC
	DJNZ	.RTCCHAR
.RTCEND:
	LD		A,13
	CALL	CHPUT
	LD		A,10
	CALL	CHPUT
	LD		E,1
	CALL	RTCCLOSE
	POP		HL
	OR		A
	RET

_RTCSET:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,FRMEVL		;evalua el texto
	CALL	CALBAS
	LD      A,(VALTYP)
	CP      3               ; Text type?
	JP      NZ,TYPE_MISMATCH
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	PUSH	HL				;puntero de BASIC
	LD		E,2				;FOR OUTPUT
	CALL	RTCOPEN
	CALL	GETSTRPNT		;HL=texto, B=largo
	LD		A,B
	OR		A
	JR		Z,.SETEOL			;texto vacio: que conteste el firmware
.SETCHAR:
	LD		A,CMD_DEVOUT
	CALL	WriteCommand
	LD		A,(HL)
	INC		HL
	CALL	WriteByte
	DJNZ	.SETCHAR
.SETEOL:
	LD		A,CMD_DEVOUT
	CALL	WriteCommand
	LD		A,13			;el CR cierra la linea y la ejecuta
	CALL	WriteByte
.SETWAIT:
	CALL	ReadByte		;mientras escribe el chip contesta DEV_BUSY
	CP		DEV_BUSY
	JR		Z,.SETWAIT
	PUSH	AF
	LD		E,2
	CALL	RTCCLOSE
	POP		AF
	POP		HL				;puntero de BASIC
	OR		A
	RET		Z
	JP		DEVERR			;el firmware manda el numero de error de BASIC

; Abre y cierra el dispositivo 0 (RTC) sin texto tras los dos puntos. E = modo,
; 1 entrada y 2 salida, como en el OPEN de BASIC.

RTCOPEN:
	LD		A,CMD_DEVOPEN
	CALL	WriteCommand
	XOR		A
	CALL	WriteByte		;ID 0
	LD		A,E
	CALL	WriteByte		;modo
	XOR		A
	CALL	WriteByte		;sin texto tras los ":"
	CALL	ReadByte
	OR		A
	RET		Z
	JP		DEVERR

RTCCLOSE:
	LD		A,CMD_DEVCLOSE
	CALL	WriteCommand
	XOR		A
	CALL	WriteByte		;ID 0
	LD		A,E
	JP		WriteByte		;modo

; CALL SDFFILES
;
; Lista los .DSK de la raiz de la SD. No tiene argumentos: la hace entera
; SDFFILES en PAGE2.MAC.

_SDFFILES:
	LD		IX,P2_SDFFILES
	JP		CALLP2

; CALL SDFMOUNT(drive, "archivo")
;
; Monta una imagen DSK de la raiz de la SD en el drive indicado, 0=A 1=B.
; El firmware valida el pedido y contesta 0 si la monto, o directamente el
; numero de error de BASIC a mostrar: asi la ROM no carga con los mensajes.
; Queda en la pagina 1 porque el nombre puede estar en la RAM de la pagina 2.

_SDFMOUNT:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,GETBYT		;evalua el drive, 0-255 en A
	CALL	CALBAS
	PUSH	AF
	CALL	CHKCHAR
	DEFB	","             ; Check for ,
	LD		IX,FRMEVL		;evalua el nombre
	CALL	CALBAS
	LD      A,(VALTYP)
	CP      3               ; Text type?
	JP      NZ,TYPE_MISMATCH
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		AF				;drive
	PUSH	HL				;puntero de BASIC
	PUSH	AF
	LD		A,CMD_SDFMOUNT
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive
	CALL	GETSTRPNT		;HL=nombre, B=largo
	CALL	SENDNAME
SDFRESULT:							;final comun de SDFMOUNT y SDFUMOUNT
	CALL	ReadByte		;0=ok, si no el numero de error de BASIC
SDFERROR:							;SDFNEW entra aca, con el resultado en A
	POP		HL				;puntero de BASIC
	OR		A
	RET		Z
	LD		E,A
	LD		IX,ERRHAND		; Call the Basic error handler
	JP		CALBAS

; CALL SDFUMOUNT(drive)
;
; Desmonta la imagen del drive indicado, 0=A 1=B. El drive queda vacio, tambien
; despues de apagar, y el DOS contesta "Disk offline" hasta el proximo SDFMOUNT.

_SDFUMOUNT:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,GETBYT		;evalua el drive, 0-255 en A
	CALL	CALBAS
	PUSH	AF
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		AF				;drive
	PUSH	HL				;puntero de BASIC
	PUSH	AF
	LD		A,CMD_SDFUMOUNT
	CALL	WriteCommand
	POP		AF
	CALL	WriteByte		;drive
	JR		SDFRESULT

; CALL SDFNEW("archivo"[, tamaño])
;
; Crea en la raiz de la SD una imagen DSK en blanco y formateada, de 720 o de
; 360 KB segun el tamaño (sin tamaño, 720). No la monta. Si el nombre no tiene
; extension, el firmware le agrega .DSK.
; Aca solo se leen los argumentos y se manda el pedido, porque el nombre puede
; estar en la RAM de la pagina 2. La espera y el formateo los hace NEWDSK en
; PAGE2.MAC.

_SDFNEW:
	CALL	CHKCHAR
	DEFB	"("             ; Check for (
	LD		IX,FRMEVL		;evalua el nombre
	CALL	CALBAS
	LD      A,(VALTYP)
	CP      3               ; Text type?
	JP      NZ,TYPE_MISMATCH
	LD		DE,(USR)		;descriptor del nombre: evaluar el tamaño pisa USR
	PUSH	DE
	CALL	GETPREVCHAR		;A = proximo caracter
	LD		E,MEDIA_720K	;sin tamaño, 720 KB
	CP		","
	JR		NZ,.NEWCLOSE
	CALL	CHKCHAR
	DEFB	","             ; Check for ,
	LD		IX,FRMQNT		;evalua el tamaño, entero en DE
	CALL	CALBAS
	PUSH	HL				;puntero de BASIC
	EX		DE,HL			;HL = tamaño
	LD		E,MEDIA_720K
	LD		BC,720
	OR		A
	SBC		HL,BC
	JR		Z,.NEWSIZE
	LD		E,MEDIA_360K
	LD		BC,360-720		;HL tiene tamaño-720
	OR		A
	SBC		HL,BC
	JP		NZ,ILLEGAL_FUNCTION	;ni 720 ni 360
.NEWSIZE:
	POP		HL
.NEWCLOSE:
	PUSH	DE				;E = media
	CALL	CHKCHAR
	DEFB	")"             ; Check for )
	POP		DE
	POP		BC				;descriptor del nombre
	PUSH	HL				;puntero de BASIC
	LD		A,CMD_SDFNEW
	CALL	WriteCommand
	LD		A,E
	CALL	WriteByte		;media: el tamaño
	LD		H,B
	LD		L,C
	CALL	STRDESC			;HL=nombre, B=largo
	CALL	SENDNAME
	LD		IX,P2_NEWDSK	;espera al firmware y formatea la imagen
	CALL	CALLBOOT		;A = 0 o el numero de error de BASIC
	JP		SDFERROR

; CALL SDFTEST
;
; Diagnostico: verifica que el firmware conteste y que hable el mismo protocolo
; que esta ROM. No tiene argumentos: lo hace entero SDFTEST en PAGE2.MAC.

_SDFTEST:
	LD		IX,P2_SDFTEST
	JP		CALLP2
	
; MTOFF
;
; Input:	None
; Output:	None
; Changed:	AF,BC,DE,HL,IX,IY may be affected

	PUBLIC	MTOFF
MTOFF:
	PUSH	AF
	LD		A,CMD_MTOFF
	CALL	WriteCommand
	POP		AF
	RET

;---------------------------
GETSTRPNT:
; OUT:
; HL = String Address
; B  = Lenght

	LD      HL,(USR)
STRDESC:					;lo mismo, con el descriptor en HL
	LD      B,(HL)
	INC     HL
	LD      E,(HL)
	INC     HL
	LD      D,(HL)
	EX      DE,HL
	RET

; Le manda al firmware el largo y el nombre: HL=nombre, B=largo
SENDNAME:
	LD		A,B
	CALL	WriteByte		;largo
	OR		A
	RET		Z
.SENDCHAR:
	LD		A,(HL)
	CALL	WriteByte
	INC		HL
	DJNZ	.SENDCHAR
	RET

CHKCHAR:
	CALL	GETPREVCHAR		; Get previous basic char
	EX		(SP),HL
	CP		(HL) 	        ; Check if good char
	JR		NZ,SYNTAX_ERROR	; No, Syntax error
	INC		HL
	EX		(SP),HL
	INC		HL				; Get next basic char
	JP		GETPREVCHAR		;sin esto caia en TYPE_MISMATCH

ILLEGAL_FUNCTION:
	LD		E,5
	DB		1				;LD BC,nn: saltea el LD E siguiente

TYPE_MISMATCH:
	LD      E,13
	DB      1

SYNTAX_ERROR:
	LD      E,2
	LD		IX,ERRHAND		; Call the Basic error handler
	JP		CALBAS

;=======================================================================
; OEMDEV — dispositivo de BASIC (entrada DEVICE de la cabecera)
;=======================================================================
;
; La entrada DEVICE (4006h) viene en 0 desde DOSHEAD: la escribe mkrom.py con
; la direccion de este simbolo. Tiene que estar en la PAGINA 1: BASIC llama por
; CALSLT con la pagina 2 en RAM, porque ahi puede estar el FCB.
;
; Entra con:
;   A = FFh          reconocer un nombre. El nombre, sin los ":" y en
;                    mayusculas, esta en PROCNM. Contestar el ID (0-3) con
;                    carry en 0, o carry en 1 si no es nuestro.
;   A = 0,2,...,18   funcion, HL = FCB, (DEVICE) = el ID que dimos.
;                    0 OPEN, 2 CLOSE, 4 aleatorio, 6 salida, 8 entrada,
;                    10 LOC, 12 LOF, 14 EOF, 16 FPOS, 18 devolver caracter.
;
; La ROM no sabe que dispositivos existen: le pasa el nombre al firmware y
; despues hace de tubo de bytes. Un dispositivo nuevo (I2C:, GPIO:...) es
; firmware, no ROM. El texto que va despues de los ":" viaja en el OPEN: con
; el, "RTC:N" puede contestar otro formato que "RTC:".
;
; El byte FCB+6 guarda el caracter devuelto por la funcion 18, como hace CAS.

	PUBLIC	OEMDEV
OEMDEV:
	INC		A
	JR		Z,DEVFIND		;era FFh: reconocer el nombre
	DEC		A

	PUSH	HL				;el FCB, para el que atienda
	CP		20
	JP		NC,DEVILL		;funcion que no existe
	RRCA					;las funciones son pares: /2 es el indice
	LD		L,A
	LD		H,0
	ADD		HL,HL
	PUSH	DE				;OJO: DE es del llamador. El OPEN lee el modo en E y el
	LD		DE,DEVFN		;codigo en D, asi que armar el indice lo pisaba
	ADD		HL,DE
	LD		A,(HL)
	INC		HL
	LD		H,(HL)
	LD		L,A
	POP		DE
	EX		(SP),HL			;la rutina queda en la pila y HL vuelve a ser el FCB
	RET						;"salta" a la rutina, que vuelve al llamador

DEVFN:
	DEFW	DEVOPEN			;0
	DEFW	DEVCLOSE		;2
	DEFW	DEVILL			;4  aleatorio: como CRT/LPT, error 58
	DEFW	DEVOUT			;6
	DEFW	DEVIN			;8
	DEFW	DEVPOS			;10 LOC
	DEFW	DEVPOS			;12 LOF
	DEFW	DEVEOF			;14
	DEFW	DEVPOS			;16 FPOS
	DEFW	DEVBACK			;18

; Reconocer el nombre: se lo pasamos al firmware tal cual viene en PROCNM.
DEVFIND:
	LD		A,CMD_DEVNAME
	CALL	WriteCommand
	LD		HL,PROCNM
.send:
	LD		A,(HL)
	INC		HL
	CALL	WriteByte
	OR		A
	JR		NZ,.send		;incluido el 0 final
	CALL	ReadByte
	CP		4				;0-3 es nuestro; 0FFh (o el bus flotando) no
	CCF
	RET

; Funcion 0 — OPEN. E = modo (1 entrada, 2 salida, 4 aleatorio, 8 append),
; D = codigo de dispositivo. Hay que dejar el modo en (HL) y el FCB en PTRFIL.
DEVOPEN:
	LD		(HL),E
	LD		(PTRFIL),HL
	PUSH	HL
	PUSH	DE

	LD		A,CMD_DEVOPEN
	CALL	WriteCommand
	LD		A,(DEVICE)
	CALL	WriteByte
	POP		DE
	LD		A,E
	CALL	WriteByte		;el modo

	;FILNAM son 11 bytes rellenados con espacios: mando solo lo util
	LD		HL,FILNAM+10
	LD		B,11
.trim:
	LD		A,(HL)
	CP		' '
	JR		NZ,.len
	DEC		HL
	DJNZ	.trim
.len:
	LD		A,B
	CALL	WriteByte		;largo, 0 si no hay texto tras los ":"
	OR		A
	JR		Z,.done
	LD		HL,FILNAM
.name:
	LD		A,(HL)
	INC		HL
	CALL	WriteByte
	DJNZ	.name
.done:
	CALL	ReadByte		;0, o el error de BASIC que quiere el firmware
	POP		HL
	OR		A
	JR		NZ,DEVERR

	;el caracter devuelto por la funcion 18 arranca vacio
	LD		DE,6
	ADD		HL,DE
	LD		(HL),0
	RET

; Funcion 2 — CLOSE.
DEVCLOSE:
	LD		A,(HL)			;el modo que dejo el OPEN en el FCB: sin el, cerrar
	PUSH	AF				;el archivo de entrada cerraria tambien el de salida
	LD		A,CMD_DEVCLOSE
	CALL	WriteCommand
	LD		A,(DEVICE)
	CALL	WriteByte
	POP		AF
	JP		WriteByte

; Funcion 6 — salida secuencial, C = caracter. El CR cierra la linea: ahi el
; firmware la ejecuta y contesta. El llamador restaura todos los registros.
DEVOUT:
	LD		A,CMD_DEVOUT
	CALL	WriteCommand
	LD		A,C
	CALL	WriteByte
	CP		13
	RET		NZ
.wait:
	CALL	ReadByte		;mientras trabaja contesta DEV_BUSY
	CP		DEV_BUSY
	JR		Z,.wait
	OR		A
	RET		Z
	JR		DEVERR

; Funcion 8 — entrada secuencial. Devuelve el caracter en A, o carry si no hay
; mas datos. El 0 del firmware es el fin de datos: el texto no lleva ceros.
DEVIN:
	LD		DE,6
	ADD		HL,DE
	LD		A,(HL)			;caracter devuelto por la funcion 18
	OR		A
	JR		Z,.fw
	LD		(HL),0
	RET						;A el caracter, carry en 0

.fw:
	LD		A,CMD_DEVIN
	CALL	WriteCommand
	CALL	ReadByte
	OR		A
	RET		NZ				;hay caracter, carry en 0
	SCF
	RET						;fin de datos

; Funcion 14 — EOF. Ademas del fin de datos, el firmware lo usa para avisar que
; lo que va a leerse no es confiable (el reloj nunca puesto, por ejemplo).
DEVEOF:
	LD		A,CMD_DEVEOF
	CALL	WriteCommand
	CALL	ReadByte
	OR		A
	JR		Z,.put
	LD		A,0FFH			;-1, cualquier cosa distinta de 0 es "si"
.put:
	JP		PUTINT

; Funcion 18 — devolver un caracter, C. Uno por archivo, en FCB+6, como CAS.
DEVBACK:
	LD		DE,6
	ADD		HL,DE
	LD		(HL),C
	RET

; Funciones 10, 12 y 16 — LOC, LOF y FPOS: como CRT, LPT y CAS, error 5.
DEVPOS:
	LD		A,5
	JR		DEVERR

; Funcion 4 — aleatorio: como CRT y LPT, error 58.
DEVILL:
	LD		A,58

; Error de BASIC en A. Con el bit 7 puesto no es un error: es el bus flotando
; o un firmware que no entiende el comando.
DEVERR:
	CP		128
	JR		C,.go
	LD		A,ERR_DEVICE_IO
.go:
	LD		E,A
	LD		IX,ERRHAND
	JP		CALBAS

; BOOTSEC
;
; Plantilla del sector de arranque que escriben DSKFMT y CALL SDFNEW: el
; BOOT.Z80 del kit de ASCII, el codigo que carga MSXDOS.SYS. Queda en la pagina
; 1, con el resto del kit, para que la pagina 2 no lleve codigo de terceros.
; FORMAT (PAGE2.MAC) le completa el BPB, bytes 0Bh-1Dh, segun el formato.
;
; Va AL FINAL a proposito: el END de BOOT.Z80 termina el ensamblado de este
; archivo, asi que nada de lo que siguiera al INCLUDE se ensamblaria. Por lo
; mismo el largo sale de NOTFIRST, la ultima etiqueta de BOOT.Z80: es una
; variable de un byte que no hace falta grabar. El Makefile pasa -id build.

BOOTSEC:
	INCLUDE	BOOT.Z80
